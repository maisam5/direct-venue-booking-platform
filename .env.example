# Supabase PostgreSQL Connection Strings
# Transaction-mode pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode direct connection for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & RBAC
NEXT_PUBLIC_SUPABASE_URL="https://gbhmadabkhbadbywhckl.supabase.co"
